{
  "name": "claude-telegram-bridge",
  "version": "0.1.0",
  "description": "Free, self-hosted Telegram bridge for Claude Code: get notified on your phone when a session finishes, reply to continue it.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "claude-telegram-bridge": "./bin/bridge.js"
  },
  "scripts": {
    "start": "node ./bin/bridge.js start",
    "test": "node --test test/**/*.test.js",
    "build:sea": "node ./scripts/build-sea.mjs"
  },
  "license": "MIT",
  "author": "Victorow",
  "keywords": ["claude-code", "telegram", "bot", "notifications", "remote-control", "bridge"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victorow/claude-telegram-bridge.git"
  },
  "homepage": "https://github.com/Victorow/claude-telegram-bridge#readme",
  "bugs": {
    "url": "https://github.com/Victorow/claude-telegram-bridge/issues"
  },
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
